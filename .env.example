# Copier ce fichier en .env (non versionné) puis adapter.
# Aucune de ces variables n'est nécessaire pour le mode "sans LLM" ni pour les tests.

# Fournisseur LLM : "none" (défaut, déterministe) ou "anthropic"
TA_LLM_PROVIDER=none
TA_LLM_MODEL=claude-opus-5-5
TA_LLM_EFFORT=medium
TA_LLM_TIMEOUT_S=60
TA_LLM_MAX_RETRIES=2
# Fallback serveur en cas de refus du modèle (beta Anthropic). true/false
TA_LLM_SERVER_FALLBACK=true

# Clé Anthropic : à définir localement uniquement, jamais dans le dépôt.
# ANTHROPIC_API_KEY=

# Garde-fous
TA_MAX_FILE_MB=50
TA_MAX_FEATURES=50000
TA_MAX_AREA_KM2=100

# Analyse
TA_BUFFER_M=200
# CRS métrique imposé (ex. EPSG:2154). Vide = UTM estimé automatiquement.
TA_METRIC_CRS=
TA_STALE_DATA_YEARS=5
